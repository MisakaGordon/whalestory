{
  "name": "@gordon2moon/dsh-whalestory",
  "version": "0.1.0",
  "type": "module",
  "description": "大肥鱼伴游：在 Harness 输入框上方显示会散步、吐槽、偶尔请旁白模型说一句话的蓝色鲸鱼娘。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "narrate.js",
    "client.js",
    "cordis.patch.yml",
    "assets/*.webp",
    "locale/*.json",
    "icon.svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MisakaGordon/whalestory.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/MisakaGordon/whalestory#readme",
  "bugs": {
    "url": "https://github.com/MisakaGordon/whalestory/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "companion",
    "whale"
  ],
  "license": "GPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
